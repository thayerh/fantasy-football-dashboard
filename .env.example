# Sleeper league to ingest.
# Find it in the Sleeper web app URL: sleeper.com/leagues/<league_id>/team
FFD_SLEEPER_LEAGUE_ID=123456789012345678

# Path to the SQLite database (relative paths resolve from the repo root).
FFD_DB_PATH=data/ffd.db

# Where `ffd backup` writes snapshots, and how many to retain.
FFD_BACKUP_DIR=data/backups
FFD_BACKUP_KEEP=14

# Data older than this many seconds marks /api/health as stale.
# Should comfortably exceed the ffd-sync.timer interval (300s).
FFD_STALE_AFTER_SECONDS=900

# Directory holding the built frontend. Served at / when it exists.
FFD_STATIC_DIR=frontend/dist


FFD_FANTASYPROS_KEY=123456789

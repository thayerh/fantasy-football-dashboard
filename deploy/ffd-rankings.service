[Unit]
Description=Refresh FantasyPros consensus rankings
After=network-online.target ffd-players.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/devcode/fantasy/fantasy-football-dashboard
ExecStart=/usr/bin/env uv run ffd sync-rankings
ExecStart=/usr/bin/env uv run ffd sync-adp
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Two jobs, run in order, neither of which spends the 50-a-day API budget:
#   sync-rankings  one HTTP request to the public cheat sheet, which embeds the
#                  complete ranking set (~517 players).
#   sync-adp       renders the real-time ADP page in a headless browser and
#                  reads its Sleeper column (~270 players), which the JSON API
#                  will not serve on the free tier. Takes about three seconds.
#
# A failing ExecStart stops the rest, so a broken scrape does not silently
# leave ADP stale as well.
#
# Runs after ffd-players: rankings are stored against Sleeper player ids, and
# a ranked rookie the pool has not seen yet is dropped with a warning.

[Install]
WantedBy=default.target

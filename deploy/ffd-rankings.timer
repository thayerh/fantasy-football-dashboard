[Unit]
Description=Refresh FantasyPros rankings daily
# Consensus rankings move daily in preseason and weekly in season. Once a day
# is enough, and one request a day is a reasonable thing to ask of someone
# else's web server.

[Timer]
# 04:00, an hour after the player pool's own window, so the pool it matches
# against is already current.
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=20min
Persistent=true
Unit=ffd-rankings.service

[Install]
WantedBy=timers.target
